---
// One card inside a MegaMenu panel. Variant is derived from the panel's `style`
// and the card's own `kind`/`variant` (see `menus[].cards[]` in src/data/sitemap.js):
//   style 'cards' → 'yellow'   (photo + label, e.g. The Foot Health Kit) or
//                   'teal'     (CTA, no photo, big label — e.g. "Shop All")
//                   'teal-bar' (kind:'bar' — teal collection CTA bar, e.g.
//                               Shop Best Sellers; grouped by MegaMenu.astro
//                               into a stacked column alongside photo cards)
//   style 'bars'  → 'bar'      (Resources — small yellow text bar)
//   style 'white' → 'white'    (Contact — white card, big label)
const { card, style } = Astro.props;
const variant =
  style === 'bars' ? 'bar' :
  style === 'white' ? 'white' :
  card.kind === 'bar' ? 'teal-bar' :
  (card.variant ?? 'yellow');
const big = variant === 'teal' || variant === 'white';
const arrowSrc = big ? '/images/nav/arrow-lg.svg' : '/images/nav/arrow.svg';
const arrowSize = big ? 64 : 24;
const fit = card.fit ?? 'cover';
// Figma (1217:1577) backs a 'contain'-fit image with a white panel, since
// contain letterboxes and the card's own background would otherwise show
// through (a real legibility problem for the yellow-on-yellow Walk book
// cover). 'cover'-fit images fill their slot and never letterbox, so they
// get no panel — matching Figma, which gives Foot Health Kit (cover) no
// such wrapper. Scoped to the contain case only: today that's the Walk
// card alone, so every other card's media markup is unchanged.
const mediaContain = fit === 'contain';
---
<a class={`nav-card nav-card--${variant}`} href={card.href}>
  {card.image && (
    <span class={`nav-card__media${mediaContain ? ' nav-card__media--contain' : ''}`}>
      <img
        src={card.image}
        alt=""
        loading="lazy"
        class="nav-card__img"
        style={`object-fit: ${fit};`}
      />
    </span>
  )}
  <span class={`nav-card__row${big ? ' nav-card__row--display' : ''}`}>
    <span class={`nav-card__label${big ? ' nav-card__label--display' : ''}${card.italic ? ' nav-card__label--italic' : ''}`}>{card.label}</span>
    {variant === 'teal-bar'
      ? <span class="nav-card__arrow" aria-hidden="true" />
      : <img class="nav-card__arrow" src={arrowSrc} width={arrowSize} height={arrowSize} alt="" />}
  </span>
</a>
<style>
  .nav-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-2);
    /* Fills the panel: 'yellow'/'teal'/'white' are direct flex-row children of
       .mega__inner (stood up to --mega-height), 'bar' is a flex-column child
       of .mega__col (explicit --mega-height, 2 stacked) — flex-basis:0 below
       makes 'bar' share that height ~evenly regardless of this percentage. */
    height: 100%;
    padding: var(--space-5);
    text-decoration: none;
  }
  /* cards/white variants are direct children of the panel row (share its full
     width evenly); bar variant fills its column slot (~half the column each) */
  .nav-card--yellow,
  .nav-card--teal,
  .nav-card--white {
    flex: 1 1 0;
  }
  .nav-card--bar {
    flex: 1 1 0;
    min-height: 0;
  }
  /* All variants (photo and no-photo) anchor the label+arrow row to the
     BOTTOM-LEFT, per the Figma mega-nav cards (label bottom-left, arrow
     bottom-right) — inheriting the base .nav-card `justify-content: flex-end`
     + the row's `justify-content: space-between`. */

  .nav-card--yellow { background: var(--color-yellow); color: var(--color-ink); }
  .nav-card--teal { background: var(--color-teal); color: var(--color-ink); }
  .nav-card--bar { background: var(--color-yellow); color: var(--color-ink); }
  .nav-card--white { background: var(--color-paper); color: var(--color-ink); }
  /* Shop's two "bar" CTAs (Shop Best Sellers / Shop All Products, Figma
     1217:1577): same box as .nav-card--bar (fills its .mega__col slot),
     but teal with a white label + white arrow. */
  .nav-card--teal-bar { background: var(--color-teal); color: var(--color-paper); flex: 1 1 0; min-height: 0; }

  .nav-card__media {
    position: relative;
    flex: 1 1 0;
    min-height: 0;
    overflow: hidden;
  }
  .nav-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Contain-fit images (Walk's book cover) letterbox inside their slot;
     Figma backs that letterbox area with a white panel rather than letting
     the card's own background (yellow, in Walk's case) show through.
     Cover-fit cards never letterbox, so they don't get this — no-op for
     every card except the one(s) using `fit: 'contain'` in sitemap.js. */
  .nav-card__media--contain {
    background: var(--color-paper);
  }

  .nav-card__row {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .nav-card__label {
    font: var(--type-nav-label);
  }
  .nav-card__label--display { font: var(--type-display); }
  /* Optional per-card italic (sitemap.js `card.italic`), e.g. the Walk book
     title (Figma: Montserrat Bold Italic vs. Foot Health Kit's plain Bold).
     Absent ⇒ no class ⇒ upright, unchanged from today. */
  .nav-card__label--italic { font-style: italic; }

  .nav-card__arrow {
    flex-shrink: 0;
    transition: transform var(--motion-fast) var(--ease-out-expo);
  }
  /* teal-bar's arrow is a blank <span> (not an <img>, per the other variants)
     recoloured white via a currentColor mask — arrow.svg is a fixed dark
     colour and an <img> can't be recoloured by masking itself. Same
     mask+currentColor technique as PlpCard.astro's `.plp-card__cta-arrow`.
     Scoped to .nav-card--teal-bar only so the Resources yellow bars and the
     photo-card <img> arrows are untouched. */
  .nav-card--teal-bar .nav-card__arrow {
    width: 24px;
    height: 24px;
    background-color: currentColor;
    -webkit-mask: url(/images/nav/arrow.svg) no-repeat center / contain;
    mask: url(/images/nav/arrow.svg) no-repeat center / contain;
  }
  .nav-card:hover .nav-card__arrow,
  .nav-card:focus-visible .nav-card__arrow {
    transform: translateX(6px);
  }
</style>
