---
import { menus } from '../data/sitemap.js';
import AnnouncementBar from './AnnouncementBar.astro';
---
<header class="site-header">
  <div class="navrow">
    <div class="container navrow__inner">
      <div class="navrow__left">
        <a href="/" class="logo" aria-label="Gait Happens — Home">
          <span class="logo__box">
            <span class="logo__mark"><img src="/images/nav/logo-mark.svg" alt="" /></span>
            <span class="logo__gait"><img src="/images/nav/logo-gait.svg" alt="" /></span>
            <span class="logo__happens"><img src="/images/nav/logo-happens.svg" alt="" /></span>
          </span>
        </a>
        <nav class="top" aria-label="Primary">
          {menus.map((m) =>
            m.type === 'link' ? (
              <a class="top__item" href={m.href}>{m.label}</a>
            ) : (
              <button type="button" class="top__item" data-menu-trigger={m.id} aria-expanded="false">{m.label}</button>
            )
          )}
        </nav>
      </div>
      <div class="util">
        <span class="lang">
          <span class="lang__label">ENGLISH</span>
          <img src="/images/nav/icon-chevron-down.svg" alt="" width="24" height="24" />
        </span>
        <div class="util__icons">
          <button type="button" class="util__btn" data-util="search" aria-label="Search">
            <img src="/images/nav/icon-search.svg" alt="" width="24" height="24" />
          </button>
          <button type="button" class="util__btn" data-util="account" aria-label="Account" aria-expanded="false">
            <img src="/images/nav/icon-user.svg" alt="" width="24" height="24" />
          </button>
          <button type="button" class="util__btn" data-util="cart" aria-label="Cart">
            <img src="/images/nav/icon-cart.svg" alt="" width="24" height="24" />
          </button>
        </div>
      </div>
    </div>
  </div>
  <AnnouncementBar />
  <!-- MegaMenu panels + AccountMenu + overlays injected in Tasks 6-8 -->
</header>
<style>
  .navrow {
    background: var(--color-ink);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .navrow__inner {
    padding-block: var(--space-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .navrow__left {
    display: flex;
    align-items: center;
    gap: var(--space-7);
  }

  .logo { display: block; }

  .logo__box {
    position: relative;
    display: block;
    width: 148px;
    height: 26.929px;
  }
  .logo__box span { position: absolute; display: block; }
  .logo__box img { width: 100%; height: 100%; display: block; }
  .logo__mark { top: 0; right: 92.61%; bottom: 0.02%; left: 0; }
  .logo__gait { top: 24.99%; right: 55.87%; bottom: 24.2%; left: 10.35%; }
  .logo__happens { top: 25.25%; right: 0; bottom: 9.39%; left: 45.89%; }

  .top { display: flex; align-items: center; }
  .top__item {
    font: var(--type-label);
    color: var(--color-paper);
    background: none;
    border: 0;
    cursor: pointer;
    padding-block: var(--space-3);
    padding-inline: var(--space-5);
  }

  .util { display: flex; align-items: center; gap: var(--space-5); }

  .lang { display: flex; align-items: center; gap: var(--space-2); color: var(--color-paper); }
  .lang__label { font: var(--type-caption); text-transform: uppercase; letter-spacing: var(--tracking-caption); }
  .lang img { display: block; }

  .util__icons { display: flex; align-items: center; gap: var(--space-2); }
  .util__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }
  .util__btn img { display: block; }

  @media (max-width: 820px) {
    .top,
    .lang { display: none; }
  }
</style>
