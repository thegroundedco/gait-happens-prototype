---
// PDP composer — data-driven (Task 1 of the Course PDP Chunk A plan).
//
// Tasks 1-6 built this composer as a hardcoded stack (Product Details ->
// 4 Column -> Brand -> CrossSell -> Reviews -> LogoWall, matching the
// Figma order: Product Details -> 4 Column -> Brand -> Product Cards
// (cross-sell) -> Reviews -> Logo Wall). This task generalizes that stack
// into a `type -> { Component, props }` REGISTRY driven by the item's own
// `item.pdp.sections` (an ordered array of `type` strings, or `{ type,
// ...data }` objects), so the same composer can also drive course PDPs
// (Sole Switch Pro, etc.) whose section list mixes reused sections
// (four-column, cross-sell, pdp-reviews, logo-wall) with course-only
// sections that don't exist yet.
//
// Each registry entry's `props` resolver reproduces exactly what that
// section received before this refactor, INCLUDING its guard: `four-column`
// only renders when `item.pdp.features` is non-empty, `pdp-reviews` only
// when `item.pdp.reviews` carries a real rating/count (see that entry's own
// comment below — final review fix wave; every object-valued section's
// guard now checks its own non-emptiness, not bare presence, the same
// `?.length > 0` standard the array-valued sections below already held
// themselves to). A resolver returning `null` means "guarded off" — no
// section, and (unlike a naive `{...data}` spread) no empty `data-reveal`
// wrapper either, matching the pre-refactor `{condition && (<div
// data-reveal>...)}` output byte-for-byte.
//
// A `type` with no registry entry renders nothing — no crash, no markup,
// just a dev-only console.warn — so a course item can list its full
// intended section order today and have the not-yet-built slots fill in
// silently as later tasks add registry entries. Task 2 added `course-details`
// (the course hero, CourseDetails.astro); Task 3 added `course-overview`
// (CourseOverview.astro); Task 4 added `youll-stop-and-instead`
// (YoullStopAndInstead.astro); Task 5 added `comparison-chart`
// (ComparisonChart.astro); Task 6 added `testimonial` (Testimonial.astro);
// Task 7 added `your-instructors` (YourInstructors.astro); Task 8 added
// `faqs` (Faqs.astro) — the last course-only type for Chunk A, so every
// entry in Sole Switch Pro's `pdp.sections` list assembled end to end.
// Course PDP Chunk B2 Task 3 adds `three-column-info` (ThreeColumnInfo.astro),
// the 14th registry type and Gait Foundations' own new section. Task 4 adds
// `image-with-text` (ImageWithText.astro) below, the 15th and FINAL registry
// type — Trainer Certification's own new section (and, per that file's own
// header comment, Foot Fest's future one too, in a later chunk).
import ProductDetails from './ProductDetails.astro';
import CourseDetails from './CourseDetails.astro';
import CourseOverview from './CourseOverview.astro';
import YoullStopAndInstead from './YoullStopAndInstead.astro';
import ComparisonChart from './ComparisonChart.astro';
import Testimonial from './Testimonial.astro';
import YourInstructors from './YourInstructors.astro';
import Faqs from './Faqs.astro';
import ThreeColumnInfo from './ThreeColumnInfo.astro';
import ImageWithText from './ImageWithText.astro';
import FourColumn from './FourColumn.astro';
import BrandSection from './BrandSection.astro';
import PdpReviews from './PdpReviews.astro';
import CrossSell from '../plp/CrossSell.astro';
import LogoWall from '../plp/LogoWall.astro';
import { pressLogos } from '../../data/catalog.js';

const { item } = Astro.props;

// type -> { Component, props(item, data) }. `props` returns the exact prop
// object that type's component received pre-refactor, or `null` to signal
// "guarded off, render nothing" — never a blind `{...data}` spread, since
// each component's prop shape is genuinely heterogeneous (see file header).
const REGISTRY = {
  'product-details': {
    Component: ProductDetails,
    props: (item) => ({ item }),
  },
  'course-details': {
    Component: CourseDetails,
    props: (item) => ({ item }),
  },
  'course-overview': {
    // Guarded on the fields that actually matter (final review fix wave),
    // not bare presence — `overview: {}` (or one with only empty fields)
    // used to pass a presence check and still render the static "Course
    // Overview" <h2> with nothing underneath it, the same
    // caption-with-nothing-under-it trap this branch already killed once
    // for CourseDetails.astro's own tier block. Real content is an image,
    // a non-empty `details` array, or a non-empty `body` (string OR array —
    // matches CourseOverview.astro's own `hasBody` derivation, since a
    // bare `overview.body` truthiness check would let `body: []` slip
    // through: arrays are always truthy regardless of length).
    Component: CourseOverview,
    props: (item) => {
      const overview = item.pdp?.overview;
      const hasBody = Array.isArray(overview?.body) ? overview.body.length > 0 : Boolean(overview?.body);
      const hasContent = Boolean(overview?.image) || (overview?.details?.length ?? 0) > 0 || hasBody;
      return hasContent ? { item } : null;
    },
  },
  'four-column': {
    Component: FourColumn,
    props: (item) =>
      item.pdp?.features?.length > 0
        ? { heading: item.pdp.featuresHeading, columns: item.pdp.features }
        : null,
  },
  'youll-stop-and-instead': {
    // Guarded on the fields that actually matter (final review fix wave) —
    // the component reads `youllStop.stop.lead`/`.stop.body`/
    // `.instead.lead`/`.instead.body` directly, with no `?.` on the way
    // in, so a bare `youllStop &&` presence check would let `youllStop: {}`
    // through to a build-time crash (`.stop` of `undefined`), and a looser
    // `youllStop.stop &&`/`.instead &&` check would still let either half
    // render with an empty lead or body. Requires all four leaf fields.
    Component: YoullStopAndInstead,
    props: (item) => {
      const youllStop = item.pdp?.youllStop;
      const hasStop = Boolean(youllStop?.stop?.lead) && Boolean(youllStop?.stop?.body);
      const hasInstead = Boolean(youllStop?.instead?.lead) && Boolean(youllStop?.instead?.body);
      return hasStop && hasInstead ? { item } : null;
    },
  },
  'comparison-chart': {
    // Guarded on the fields that actually matter (final review fix wave) —
    // the component reads `comparison.columns[0]`/`[1]` and maps
    // `comparison.rows` directly, with no `?.` on the way in, so a bare
    // `comparison &&` presence check would let `comparison: {}` through to
    // a build-time crash. Requires a real 2-column header and at least one
    // row (matches this section's actual `{ columns: [c1, c2], rows }`
    // contract — see ComparisonChart.astro's own header comment).
    Component: ComparisonChart,
    props: (item) => {
      const comparison = item.pdp?.comparison;
      const hasColumns = (comparison?.columns?.length ?? 0) >= 2;
      const hasRows = (comparison?.rows?.length ?? 0) > 0;
      return hasColumns && hasRows ? { item } : null;
    },
  },
  'testimonial': {
    // Guarded like `four-column`/`your-instructors`/`faqs` above — `item.
    // pdp.testimonial` is an ARRAY (see Testimonial.astro's header comment),
    // so a presence check alone would let `testimonial: []` through and emit
    // an empty `<div data-reveal>` around a Testimonial that renders
    // nothing. `?.length > 0` guards non-emptiness, not just presence.
    Component: Testimonial,
    props: (item) => (item.pdp?.testimonial?.length > 0 ? { item } : null),
  },
  'your-instructors': {
    // Guarded like the other course-only sections above — only items with
    // real `item.pdp.instructors` data render this section.
    Component: YourInstructors,
    props: (item) => (item.pdp?.instructors?.length > 0 ? { item } : null),
  },
  'faqs': {
    // Guarded like the other course-only sections above — only items with
    // real `item.pdp.faqs` data render this section.
    Component: Faqs,
    props: (item) => (item.pdp?.faqs?.length > 0 ? { item } : null),
  },
  'three-column-info': {
    // Task 3 (Course PDP Chunk B2). Guarded like `testimonial` above —
    // `item.pdp.threeColumn.columns` must be a NON-EMPTY array (`?.length >
    // 0`, not just `?.columns`), or a `threeColumn: { columns: [] }` value
    // would slip past a presence-only check and render an empty section
    // wrapper around nothing — the exact bug class ThreeColumnInfo.astro's
    // own header comment documents at length (10 prior instances of this
    // mistake on this branch).
    Component: ThreeColumnInfo,
    props: (item) => (item.pdp?.threeColumn?.columns?.length > 0 ? { item } : null),
  },
  'image-with-text': {
    // Task 4 (Course PDP Chunk B2), the 15th and FINAL registry type.
    // Guarded like `three-column-info`/`testimonial` above — `item.pdp.
    // imageWithText.items` must be a NON-EMPTY array, not just present, or
    // an `imageWithText: { items: [] }` value would slip past a
    // presence-only check and render an empty section wrapper around
    // nothing (ImageWithText.astro's own header comment documents this same
    // bug class at length).
    Component: ImageWithText,
    props: (item) => (item.pdp?.imageWithText?.items?.length > 0 ? { item } : null),
  },
  'brand-section': {
    // Desktop-only per BrandSection.astro's own `@media (max-width: 1023px)
    // { display: none }` — no composer-level guard needed, same as before.
    Component: BrandSection,
    props: () => ({}),
  },
  'cross-sell': {
    // Guarded on the fields that actually matter (final review fix wave) —
    // the old bare `item.pdp?.crossSell &&` presence check is exactly the
    // trap this comment already warned about: `crossSell: {}` would pass
    // it and render the broken band described above (empty heading, zero
    // cards, a "Shop All" `<a>` with no `href`) instead of being caught.
    // Requires the 3 fields the CTA-guard idiom (`label && href`)
    // generalizes to here: a real `heading`, at least one `itemIds` entry,
    // and a real `shopAllHref`. The catalog can't trip this today (guarded
    // by catalog.test.mjs), but the composer is the artifact being ported,
    // so it shouldn't fail open.
    Component: CrossSell,
    props: (item) => {
      const crossSell = item.pdp?.crossSell;
      const hasContent =
        Boolean(crossSell?.heading) && (crossSell?.itemIds?.length ?? 0) > 0 && Boolean(crossSell?.shopAllHref);
      return hasContent ? { crossSell } : null;
    },
  },
  'pdp-reviews': {
    // Guarded on the fields that actually matter (final review fix wave) —
    // PdpReviews.astro defaults `rating`/`count`/`distribution` internally
    // (`= 0`/`= 0`/`= []`), so a bare `item.pdp?.reviews &&` presence check
    // let `reviews: {}` through to a fully-rendered "★☆☆☆☆ Rated 0 out of
    // 5, based on 0 reviews" band instead of rendering nothing. `!= null`
    // (not bare truthiness) on both fields, matching this branch's own
    // "0 is a real value, not an absence" rule (see PlpCard.astro/
    // CourseDetails.astro's own rating guards) — a genuinely zero-review
    // course (`rating: 0, count: 0`) is still real content and should
    // still render.
    Component: PdpReviews,
    props: (item) => {
      const reviews = item.pdp?.reviews;
      const hasContent = reviews != null && reviews.rating != null && reviews.count != null;
      return hasContent ? { reviews } : null;
    },
  },
  'logo-wall': {
    Component: LogoWall,
    props: () => ({ logos: pressLogos }),
  },
};

const sections = (item.pdp?.sections ?? [])
  .map((s) => (typeof s === 'string' ? { type: s } : s))
  .map((entry) => {
    const registered = REGISTRY[entry.type];
    if (!registered) {
      if (import.meta.env.DEV) {
        // eslint-disable-next-line no-console
        console.warn(`[Pdp] "${entry.type}" has no registry entry yet (item "${item.id}") — rendering nothing.`);
      }
      return null;
    }
    const props = registered.props(item, entry);
    return props ? { Component: registered.Component, props } : null;
  })
  .filter(Boolean);
---
<div class="pdp">
  {sections.map(({ Component, props }) => (
    <div data-reveal>
      <Component {...props} />
    </div>
  ))}
</div>
