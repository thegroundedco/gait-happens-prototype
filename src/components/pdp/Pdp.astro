---
// PDP composer: product sections stack -> CrossSell -> LogoWall.
// Task 1 proves the pipeline with the two sections we already have
// (CrossSell + LogoWall, both reused from the PLP composer). Later tasks
// (2-6) insert new PDP-specific sections above the cross-sell, at the
// top-of-`.pdp` marker below.
import CrossSell from '../plp/CrossSell.astro';
import LogoWall from '../plp/LogoWall.astro';
import { pressLogos } from '../../data/catalog.js';

const { item } = Astro.props;
---
<div class="pdp">
  <!-- Tasks 2-6 insert PDP sections (gallery, buy box, size chart, brand
       story, reviews, etc.) here, above the cross-sell. -->
  <div data-reveal>
    <CrossSell crossSell={item.pdp.crossSell} />
  </div>
  <div data-reveal>
    <LogoWall logos={pressLogos} />
  </div>
</div>
