---
// PDP "4 Column" feature band (Task 4) — Figma 714:6430 (desktop, ≥1024) /
// 1017:9518 (mobile, 390). Full-width yellow band: centered heading, then a
// row of 4 white feature cards (image + bold blurb), matching the CrossSell/
// LogoWall band idiom (full-bleed colored section, `__pad` inner wrapper
// capped at --container-max).
//
// Figma's own padding for this band is 48/64 (--space-7/--space-8), not the
// 24/48 CrossSell and LogoWall use — kept band-specific per the pulled
// design context rather than copied from those siblings.
//
// Each card in both frames shows exactly ONE piece of copy: a single bold,
// centered sentence (Figma calls the layer text, the task brief calls them
// "blurbs") — there's no separate short label above it. `columns[].text` is
// that Figma-verbatim sentence (rendered bold, matching the design).
// `columns[].label` is kept as an optional smaller caption line ABOVE the
// blurb for products that may want one later — Toe Spacers' catalog entry
// leaves it unset since this Figma has no such line, and the component only
// renders it when present.
//
// ---- Optional per-card body paragraph (Chunk B2 review fix wave: component
// gap fix) ---------------------------------------------------------------
// Gait Guru Membership's own 4 Column cards (687:6575 desktop / 1129:16047
// mobile) are the first on this branch where each card shows TWO distinct
// pieces of copy instead of one: a bold 16px TITLE (authored into `text`
// above — an exact style match) AND a separate regular-weight paragraph
// BELOW it (`I687:6575;255:1028` etc. desktop, `I1129:16047;181:2391` etc.
// mobile) — confirmed via get_design_context on both breakpoints, identical
// wording/style on both. `columns[].body` is a new OPTIONAL field for that
// second paragraph, rendered only when present — every other product/course
// on this branch leaves it unset, so this is a byte-identical no-op for all
// of them. Style is Figma-exact `--type-body-sm` (400/14px) — matches this
// codebase's own DS token 1:1 (Figma's `type/body-sm` token: Regular, 14px,
// 400 weight; `--color-ink` #231f20 matches Figma's `--text-primary`
// exactly) — not a new component-intrinsic literal the way `.four-column
// __label`/`.four-column__text` are (neither DS type token pairs bold+16px
// or matches the label's own uppercase-caption shape, so those two stayed
// intrinsic; body-sm needed no such compromise). No new gap value needed
// either: `.four-column__body`'s existing --space-4 (16px) column gap
// already matches Figma's own `gap-[16px]` between title and body in both
// pulled trees, so the body paragraph just becomes a third sibling in that
// same gap-16 column.
//
// Mobile (1017:9518) reflow: the band's color assignment flips rather than
// simply reflowing to 1-column. Desktop paints the entire full-bleed section
// yellow; mobile keeps the section itself on the page's white background and
// insets a single yellow card (with its own space-5/space-7 padding) that's
// margined off the viewport edges by the section's own space-5 padding —
// reproducing Figma's fixed 342-wide yellow block centered in a 390 frame
// without hardcoding either width, so it holds up at any mobile viewport.
// Inside that inset card, the row of 4 cards switches from a horizontal
// flex (space-7 gap) to a vertical stack (space-5 gap, matching the uniform
// gap Figma uses between every child — heading and each card alike — once
// they're all stacked in one column).
const { heading, columns = [] } = Astro.props;
---
<section class="four-column">
  <div class="four-column__pad">
    <h2 class="four-column__heading">{heading}</h2>
    <div class="four-column__row">
      {columns.map((col) => (
        <div class="four-column__card">
          <span class="four-column__media">
            <img src={col.image} alt="" loading="lazy" width="252" height="179" />
          </span>
          <div class="four-column__body">
            {col.label && <p class="four-column__label">{col.label}</p>}
            <p class="four-column__text">{col.text}</p>
            {col.body && <p class="four-column__body-text">{col.body}</p>}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .four-column {
    background: var(--color-yellow);
  }

  .four-column__pad {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-7);
    padding-block: var(--space-8);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-7);
  }

  .four-column__heading {
    font: var(--type-h3);
    color: var(--color-ink);
    text-align: center;
    width: 100%;
  }

  .four-column__row {
    display: flex;
    align-items: stretch;
    gap: var(--space-7);
    width: 100%;
  }

  .four-column__card {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    background: var(--color-paper);
    min-width: 0;
  }

  .four-column__media {
    display: block;
    width: 100%;
    height: 179px;
    overflow: hidden;
  }
  .four-column__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .four-column__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-4);
  }

  /* Figma-exact 700/16px — none of the DS type tokens pair bold weight with
     16px (--type-label is 600, --type-nav-label's 700 is 20px), so this is
     component-intrinsic, matching the PdpAccordion summary label precedent. */
  .four-column__label {
    font: 600 12px/1.4 var(--font-sans);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caption);
    color: var(--color-ink);
    text-align: center;
  }
  .four-column__text {
    font: 700 16px/1.3 var(--font-sans);
    color: var(--color-ink);
    text-align: center;
  }

  /* Optional second paragraph below the bold title (see header comment,
     "Optional per-card body paragraph") — Figma-exact --type-body-sm
     (400/14px), a real DS token match unlike the two component-intrinsic
     rules above. Absent everywhere except Gait Guru Membership, so this
     rule is inert (matches no elements) on every other shipped PDP. */
  .four-column__body-text {
    font: var(--type-body-sm);
    color: var(--color-ink);
    text-align: center;
  }

  /* ---- Mobile (Figma 1017:9518, 390) --------------------------------- */
  @media (max-width: 1023px) {
    .four-column {
      background: var(--color-paper);
      padding-inline: var(--space-5);
      padding-block: var(--space-5);
    }
    .four-column__pad {
      background: var(--color-yellow);
      max-width: none;
      padding-inline: var(--space-5);
      padding-block: var(--space-7);
      gap: var(--space-5);
    }
    .four-column__row {
      flex-direction: column;
      gap: var(--space-5);
    }
  }
</style>
