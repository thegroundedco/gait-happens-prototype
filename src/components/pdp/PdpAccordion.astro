---
// Product Details accordion — built in Task 3 for Toe Spacers only (three
// fixed rows: Size / Instructions / Research). Task 7 rolls the PDP template
// out to 5 more products whose "Question" panels are product-specific and
// don't map onto that fixed shape — Foot Health Kit has What's
// Included/Finding Your Size/How To Use Your Kit; Toe Strengtheners has
// What's Included/How To Use Them; Toe Dynamometer has Instructions/Details/
// Evaluate Toe Strength; Cork Supplement and Mobility Ball have none at all.
// So this component is now DATA-DRIVEN: `item.pdp.accordion` is an array of
// rows `[{ label, content?, type? }]`.
//
// A row with `type: 'sizechart'` renders `item.sizeChart` as a table (plus
// the helper copy + sizing image) exactly as Task 3 built it — the one row
// shape that needs real structured markup rather than prose. Every other
// row renders `label` + `content`, where `content` is trusted,
// hand-authored HTML from catalog.js via `set:html` — a paragraph, a bullet
// list, a grid of YouTube embeds, a linked PDF, whatever that product's
// Question panel needs. This mirrors the task brief's framing ("content …
// may include the video-embed / citations markup") and avoids inventing a
// bespoke `type` for every shape (list vs. text+image vs. video grid vs.
// linked resource) four products need in different combinations.
//
// Toe Spacers' three rows were converted to this shape (Size stays
// `type: 'sizechart'`; Instructions/Research became `content` HTML strings)
// so its rendered output is byte-for-byte the same as before this refactor.
// Products with no accordion (Cork Supplement, Mobility Ball) simply carry
// no `pdp.accordion` — the `rows.length > 0` guard below means nothing
// renders, same graceful degradation the array shape replaced.
//
// Native <details>/<summary> — same accordion primitive MobileNav.astro's
// `.m-acc` mega-menu panels use (keyboard + screen-reader support for free,
// no script). Rows default COLLAPSED (no `open` attribute) per user request —
// the `+`/`−` summary icon reflects the state, and the Figma frames only
// showed them expanded to preview the content, not as the default state.
//
// `content` HTML is trusted/static (authored by us in catalog.js, not user
// input), so `set:html` is safe here — same trust boundary as any other
// hardcoded markup in this reference build.
//
// ---- `rows` prop (Task 8, Course PDP Chunk A) ----------------------------
// Faqs.astro reuses this component for `item.pdp.faqs` — a second row array
// on the SAME item that must not collide with a product's own
// `item.pdp.accordion`. So the data source is now an explicit `rows` prop
// with a fallback, not a hardcoded read: `rows ?? item.pdp?.accordion ?? []`.
// Every existing call site (ProductDetails.astro's `<PdpAccordion item={item}
// />`) passes no `rows` prop, so `rows` is `undefined` there and the
// fallback resolves to exactly `item.pdp?.accordion ?? []` — byte-for-byte
// the same value this line always computed pre-refactor. Product PDP output
// is therefore unchanged (verified by diffing `dist/products/*/index.html`
// before/after this change — see task-8 report).
//
// ---- `variant` prop (onTeal) ---------------------------------------------
// Faqs.astro also renders this component on a `--color-teal` section
// background (Figma 1027:12323 desktop / 1109:14385 mobile) — this
// component's DEFAULT styling below (teal border, teal summary text, teal
// +/- icon, ink body text) is built for the product PDP's plain page
// background and would be teal-on-teal (invisible) there. Rather than fork
// this component or reach for external `:global()` overrides from
// Faqs.astro, `variant="onTeal"` toggles a co-located `.pdp-accordion--on-
// teal` modifier class whose overrides live in this component's own
// `<style>` below, right next to the base rules they override. The DEFAULT
// variant (every product accordion, `variant` omitted) matches none of
// those modifier-scoped selectors, so it renders through completely
// unchanged.
const { item, rows, variant } = Astro.props;
const accordionRows = rows ?? item.pdp?.accordion ?? [];
const sizeChart = item.sizeChart;
const wrapperClass = variant === 'onTeal' ? 'pdp-accordion pdp-accordion--on-teal' : 'pdp-accordion';
---
{accordionRows.length > 0 && (
  <div class={wrapperClass}>
    {accordionRows.map((row) => (
      <details class="pdp-accordion__row">
        <summary class="pdp-accordion__summary">
          <span class="pdp-accordion__label">{row.label}</span>
          <span class="pdp-accordion__icon" aria-hidden="true"></span>
        </summary>
        {row.type === 'sizechart' && sizeChart ? (
          <div class="pdp-accordion__body pdp-accordion__body--size">
            <p>If you are choosing between sizes we recommend choosing the smaller size.</p>
            <table class="pdp-accordion__table">
              <caption class="pdp-accordion__sr-only">{`${item.title} size chart`}</caption>
              <thead>
                <tr>
                  {sizeChart.columns.map((col) => <th scope="col">{col}</th>)}
                </tr>
              </thead>
              <tbody>
                {sizeChart.rows.map((r) => (
                  <tr>
                    {r.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}
                  </tr>
                ))}
              </tbody>
            </table>
            <img
              class="pdp-accordion__image"
              src={item.image}
              alt={`${item.title} sizing reference`}
              loading="lazy"
              width="400"
              height="335"
            />
          </div>
        ) : (
          <div class="pdp-accordion__body" set:html={row.content} />
        )}
      </details>
    ))}
  </div>
)}
<style>
  .pdp-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    width: 100%;
  }

  .pdp-accordion__row {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    border: 1px solid var(--color-teal);
    padding: var(--space-4) var(--space-6);
  }

  .pdp-accordion__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    cursor: pointer;
    list-style: none;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 24px;
    line-height: 1.2;
    color: var(--color-teal);
  }
  .pdp-accordion__summary::-webkit-details-marker {
    display: none;
  }

  .pdp-accordion__icon {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font: 400 20px/1 var(--font-sans);
    color: var(--color-teal);
  }
  .pdp-accordion__icon::before {
    content: '+';
  }
  .pdp-accordion__row[open] > .pdp-accordion__summary .pdp-accordion__icon::before {
    content: '\2212'; /* − — same glyph ProductDetails.astro's qty stepper uses */
  }

  .pdp-accordion__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    font: var(--type-body-sm);
    color: var(--color-ink);
  }
  .pdp-accordion__body--size {
    gap: var(--space-5);
  }

  @media (prefers-reduced-motion: no-preference) {
    .pdp-accordion__row[open] > .pdp-accordion__body {
      animation: pdp-accordion-reveal var(--motion-fast) var(--ease-standard);
    }
  }
  @keyframes pdp-accordion-reveal {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* ---- Size table ---------------------------------------------------- */

  .pdp-accordion__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .pdp-accordion__table {
    width: 100%;
    border-collapse: collapse;
    font: var(--type-body-sm);
  }
  .pdp-accordion__table th,
  .pdp-accordion__table td {
    border: 1px solid var(--color-teal);
    padding: var(--space-2) var(--space-3);
    text-align: left;
  }
  .pdp-accordion__table thead th {
    background: var(--color-teal);
    color: var(--color-paper);
    font: var(--type-caption);
    letter-spacing: var(--tracking-caption);
    text-transform: uppercase;
  }
  .pdp-accordion__table tbody th[scope='row'] {
    background: var(--color-teal);
    color: var(--color-paper);
    font-weight: 600;
    white-space: nowrap;
  }

  .pdp-accordion__image {
    width: 100%;
    aspect-ratio: 400 / 335;
    object-fit: cover;
    display: block;
  }

  /* ---- Generic row content --------------------------------------------
     `row.content` is injected via `set:html`, so it isn't part of this
     component's static template — Astro's scoped-style hashing only
     rewrites selectors it can see at compile time, so every rule reaching
     into that raw markup has to be `:global()` (Astro's escape hatch for
     styling content it can't statically see, e.g. slotted/injected HTML). */
  .pdp-accordion__body :global(p) {
    margin: 0;
  }
  .pdp-accordion__body :global(ul) {
    list-style: disc;
    padding-left: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
  }
  .pdp-accordion__body :global(a) {
    color: var(--color-teal);
    text-decoration: underline;
    word-break: break-word;
  }
  .pdp-accordion__body :global(img) {
    width: 100%;
    aspect-ratio: 400 / 335;
    object-fit: cover;
    display: block;
  }

  /* ---- Instructions videos ---------------------------------------------
     `content` strings that embed video grids wrap each iframe in a
     `.pdp-accordion__video` div (see catalog.js) so this component still
     owns the aspect-ratio/positioning chrome — same idea as Task 3's
     original bespoke video block, just reachable via :global() now. */
  :global(.pdp-accordion__videos) {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  :global(.pdp-accordion__video) {
    position: relative;
    width: 100%;
    max-width: 400px;
    aspect-ratio: 400 / 225;
  }
  :global(.pdp-accordion__video) iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* ---- onTeal variant (Task 8, course FAQs band) ------------------------
     See this file's header comment for the "why a modifier class, not a
     fork" reasoning. Figma 1027:12323 (desktop) / 1109:14385 (mobile) shows
     white 1px borders (not teal), bold white summary text, a white +/- icon
     enlarged to a 24x24 box (vs. the default 16x16/20px-font icon), and
     24px-vertical/32px-horizontal row padding (--space-5/--space-6, both
     breakpoints — different from the default's --space-4/--space-6). Body
     copy + any inline links also flip to white for contrast on teal.

     Row label font: Figma reads 20px/700 — no existing product-accordion
     precedent for that exact pairing (the default summary style below is a
     component-intrinsic 24px/700 literal), and none of this repo's --type-*
     tokens pair 700 with 24px either. --type-nav-label (700 20px/1.2) is an
     exact spec match for 20px/700 and is reused here purely for its visual
     spec, same "token regardless of its nav-sounding name" precedent
     FourColumn.astro's own label-token comment sets. */
  .pdp-accordion--on-teal .pdp-accordion__row {
    border-color: var(--color-paper);
    padding: var(--space-5) var(--space-6);
  }
  .pdp-accordion--on-teal .pdp-accordion__summary {
    color: var(--color-paper);
    font: var(--type-nav-label);
  }
  .pdp-accordion--on-teal .pdp-accordion__icon {
    width: 24px;
    height: 24px;
    font-size: 24px;
    color: var(--color-paper);
  }
  .pdp-accordion--on-teal .pdp-accordion__body {
    color: var(--color-paper);
  }
  .pdp-accordion--on-teal .pdp-accordion__body :global(a) {
    color: var(--color-paper);
  }

  /* ---- Chunk 4: product-accordion teal hover + persist-when-open --------
     Scoped to the DEFAULT variant (`:not(.pdp-accordion--on-teal)`) so the
     course-FAQ onTeal band's rules are neither edited nor matched here —
     it renders byte-for-byte unchanged. The row's inset moves onto the
     summary + body so the teal summary fills the bordered box edge-to-edge;
     the row gap drops to var(--space-2) so the summary→body distance stays
     the original var(--space-5) (16px summary bottom-padding + 8px gap).
     The summary bar fills solid teal (white label + white +/- icon) on
     hover and STAYS filled while the row is open; the body stays on white
     below it so its ink copy remains readable. */
  .pdp-accordion:not(.pdp-accordion--on-teal) .pdp-accordion__row {
    padding: 0;
    gap: var(--space-2);
  }
  .pdp-accordion:not(.pdp-accordion--on-teal) .pdp-accordion__summary {
    padding: var(--space-4) var(--space-6);
    transition:
      background var(--motion-fast) var(--ease-standard),
      color var(--motion-fast) var(--ease-standard);
  }
  .pdp-accordion:not(.pdp-accordion--on-teal) .pdp-accordion__body {
    padding: 0 var(--space-6) var(--space-4);
  }
  .pdp-accordion:not(.pdp-accordion--on-teal) .pdp-accordion__summary:hover,
  .pdp-accordion:not(.pdp-accordion--on-teal) .pdp-accordion__row[open] > .pdp-accordion__summary {
    background: var(--color-teal);
    color: var(--color-paper);
  }
  /* Ease the icon colour in sync with the summary so the +/- doesn't snap
     to white a beat before the bar finishes filling teal. */
  .pdp-accordion:not(.pdp-accordion--on-teal) .pdp-accordion__icon {
    transition: color var(--motion-fast) var(--ease-standard);
  }
  .pdp-accordion:not(.pdp-accordion--on-teal) .pdp-accordion__summary:hover .pdp-accordion__icon,
  .pdp-accordion:not(.pdp-accordion--on-teal) .pdp-accordion__row[open] > .pdp-accordion__summary .pdp-accordion__icon {
    color: var(--color-paper);
  }
</style>
