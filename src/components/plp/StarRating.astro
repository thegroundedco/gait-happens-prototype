---
// Row of 5 stars (filled up to `rating`, rest outline) + review count.
// The wrapper carries the full aria-label; the stars themselves are
// aria-hidden decoration so screen readers get one clean announcement.
const { rating = 0, count = 0 } = Astro.props;
const stars = [1, 2, 3, 4, 5];
const STAR_PATH =
  'M12 .587l3.668 7.568 8.332 1.151-6.064 5.828 1.48 8.279L12 19.771l-7.416 3.642 1.48-8.279L0 9.306l8.332-1.151z';
---
<span class="star-rating" aria-label={`Rated ${rating} out of 5, ${count} reviews`}>
  <span class="star-rating__stars" aria-hidden="true">
    {stars.map((n) => (
      <svg
        class={`star-rating__star${n <= rating ? ' star-rating__star--filled' : ''}`}
        width="14"
        height="14"
        viewBox="0 0 24 24"
      >
        <path d={STAR_PATH} />
      </svg>
    ))}
  </span>
  <span class="star-rating__count">({count})</span>
</span>
<style>
  .star-rating {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .star-rating__stars {
    display: inline-flex;
    gap: 2px;
  }
  .star-rating__star {
    fill: none;
    stroke: var(--color-ink-70);
    stroke-width: 1.5;
  }
  .star-rating__star--filled {
    fill: var(--color-yellow);
    stroke: var(--color-yellow);
  }
  .star-rating__count {
    font: var(--type-body-sm);
    color: var(--color-ink-70);
  }
</style>
