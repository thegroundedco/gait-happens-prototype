---
// Teal informational/CTA cell that sits inside the PLP grid (occupies one
// card-sized cell, stretches to the row height like IntroBlock/PlpCard).
// Heading (h3) + body + a white "chip" button with teal label + teal arrow.
// Matches Figma nodes 1028:10958 (Become a Wholesaler) / 1036:10411
// (Become an Ambassador!). The button href is a placeholder ('#') until the
// real wholesale/affiliate destinations are wired.
const { heading, body, cta } = Astro.props;
---
<div class="promo-card">
  <h3 class="promo-card__heading">{heading}</h3>
  <p class="promo-card__body">{body}</p>
  <a class="promo-card__cta" href={cta.href}>
    <span>{cta.label}</span>
    <span class="promo-card__cta-arrow" aria-hidden="true"></span>
  </a>
</div>
<style>
  .promo-card {
    height: 100%;
    background: var(--color-teal);
    color: var(--color-paper);
    padding: var(--space-7); /* 48px */
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5); /* 24px */
  }
  .promo-card__heading {
    font: var(--type-h3);
    color: var(--color-paper);
  }
  .promo-card__body {
    font: var(--type-body-16);
    color: var(--color-paper);
  }
  .promo-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--color-paper);
    color: var(--color-teal);
    font: var(--type-cta);
    padding: var(--space-3) var(--space-5); /* 12px 24px */
    transition: transform var(--motion-fast) var(--ease-standard);
  }
  .promo-card__cta:hover {
    transform: translateY(-2px);
  }
  .promo-card__cta-arrow {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    /* Masked so the arrow paints in the button's own text colour (teal). */
    background-color: currentColor;
    -webkit-mask: url(/images/nav/arrow.svg) no-repeat center / contain;
    mask: url(/images/nav/arrow.svg) no-repeat center / contain;
  }
  @media (prefers-reduced-motion: reduce) {
    .promo-card__cta:hover {
      transform: none;
    }
  }
</style>
