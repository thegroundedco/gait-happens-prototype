---
// Quick-Add modal (Task 8) — centered dialog + scrim, populated at runtime
// from a card's `[data-quick-add={id}]` trigger (see PlpCard.astro). One
// instance is rendered per PLP page (Plp.astro), matching the one CartDrawer
// instance Header.astro renders per page. Markup here is SSR-stable and
// starts closed (`hidden` + `inert`); the co-located client script below
// fills in title/price/image/quantity and toggles the open state, plus
// EITHER a product's variant pills + size chart OR (Task 2) a course's
// item.pdp.buybox controls (pills + Location select), mirroring
// CourseDetails.astro's PDP buybox off the same data — never both, an item
// carries one shape or the other. See that script's header comment for the
// leak-free (View-Transitions-safe) event-binding pattern.
---
<div class="quick-add-scrim" data-quick-add-scrim hidden></div>
<div
  class="quick-add-modal"
  data-quick-add-modal
  role="dialog"
  aria-modal="true"
  aria-labelledby="quick-add-title"
  aria-hidden="true"
  hidden
  inert
>
  <button type="button" class="quick-add-modal__close" data-quick-add-close aria-label="Close quick add">✕</button>

  <div class="quick-add-modal__top">
    <div class="quick-add-modal__media">
      <img data-quick-add-image src="" alt="" width="420" height="420" />
    </div>

    <div class="quick-add-modal__panel">
      <div class="quick-add-modal__title-row">
        <h3 class="quick-add-modal__title" id="quick-add-title" data-quick-add-title></h3>
        <p class="quick-add-modal__price" data-quick-add-price></p>
      </div>

      <div class="quick-add-modal__options">
        <!-- Task 3 (Foot Health Kit helper note) — optional per-item helper
             line, mounted above the size selector so a kit's own toe-spacer
             sizing note is legible before the pills below it. SSR-stable and
             `hidden` by default; populate() sets textContent + unhides it
             ONLY when the current item carries `item.quickAddNote` (today,
             only foot-health-kit), and re-hides + clears it for every other
             item so nothing leaks across quick-add opens. -->
        <p class="quick-add-modal__note" data-quick-add-note hidden></p>

        <div class="quick-add-modal__variants" data-quick-add-variants hidden>
          <span class="quick-add-modal__variants-label" data-quick-add-variants-label>Size</span>
          <div class="quick-add-modal__pills" data-quick-add-pills></div>
        </div>

        <!-- Course buybox mount (Task 2) — sibling to the size-variants block
             above, same Options-block mount point. Renders item.pdp.buybox
             (course-type pills + Location select) at populate() time,
             mirroring CourseDetails.astro's buybox render off the SAME data.
             Mutually exclusive with .quick-add-modal__variants above: an item
             has EITHER item.variants (product) OR item.pdp.buybox (course),
             never both, so populate() only ever unhides one of the two. -->
        <div class="quick-add-modal__buybox" data-quick-add-buybox hidden>
          <span class="quick-add-modal__buybox-label" data-quick-add-buybox-label></span>
          <div class="quick-add-modal__buybox-controls" data-quick-add-buybox-controls></div>
        </div>

        <div class="quick-add-modal__quantity-row">
          <div class="quick-add-modal__qty">
            <span class="quick-add-modal__qty-label" id="quick-add-qty-label">Quantity</span>
            <div class="quick-add-modal__stepper" role="group" aria-labelledby="quick-add-qty-label">
              <button type="button" class="quick-add-modal__step" data-quick-add-qty-decr aria-label="Decrease quantity">−</button>
              <span class="quick-add-modal__qty-value" data-quick-add-qty-value aria-live="polite">1</span>
              <button type="button" class="quick-add-modal__step" data-quick-add-qty-incr aria-label="Increase quantity">+</button>
            </div>
          </div>

          <button type="button" class="quick-add-modal__add" data-quick-add-submit>Add to Cart</button>
        </div>
      </div>
    </div>
  </div>

  <div class="quick-add-modal__sizechart" data-quick-add-sizechart hidden>
    <div class="quick-add-modal__sizechart-scroll">
      <table>
        <thead data-quick-add-sizechart-head></thead>
        <tbody data-quick-add-sizechart-body></tbody>
      </table>
    </div>
  </div>
</div>
<script>
  import { getItem } from '../../data/catalog.js';
  import { addLine } from '../../scripts/cart.js';

  // Astro's ClientRouter (View Transitions) swaps the DOM on navigation and
  // does NOT re-run this already-loaded module script. To stay leak-free
  // across navigations we never bind a listener to a specific element that
  // could later be swapped out from under it: every DOM lookup below is done
  // fresh, at the moment it's needed (mirrors CartDrawer.astro's render()),
  // and the interactive surface (quick-add triggers, close button, scrim,
  // variant pills, qty stepper, submit) is handled by exactly TWO document-
  // level listeners (`click`, `keydown`) registered ONCE at module scope.
  // Because state lives in module-scope variables (not cached element refs)
  // and every open() call re-populates it from scratch, there is nothing
  // that can go stale on `astro:after-swap` — the swap listener below only
  // defensively resets state in case a navigation happened while the modal
  // was open.

  // Closing is instant (state flips synchronously below) so submitAddToCart
  // can close the modal and open the cart drawer back-to-back with no race.
  //
  // `state.selections` (Task 2) generalizes the old single `state.variant`
  // into a per-control map so the same state shape covers both product size
  // pills and course buybox pills: products use ONE entry, key 'variant'
  // (the selected size); courses use one entry per `pills` control, key
  // `c${index}` (index into that item's OWN filtered buybox.controls list —
  // see populate()). A buybox `select` control's value is intentionally NOT
  // stored here — Task 3's submit-summary logic reads it straight off the
  // DOM at submit time instead, since (unlike pills) a native <select>
  // already IS its own source of truth and needs no mirrored copy.
  const state = {
    item: null,
    selections: {},
    qty: 1,
    trigger: null,
  };

  function escapeHtml(str) {
    return String(str).replace(/[&<>"']/g, (c) => (
      { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
    ));
  }

  function els() {
    return {
      modal: document.querySelector('[data-quick-add-modal]'),
      scrim: document.querySelector('[data-quick-add-scrim]'),
      title: document.querySelector('[data-quick-add-title]'),
      price: document.querySelector('[data-quick-add-price]'),
      image: document.querySelector('[data-quick-add-image]'),
      note: document.querySelector('[data-quick-add-note]'),
      variantsWrap: document.querySelector('[data-quick-add-variants]'),
      variantsLabel: document.querySelector('[data-quick-add-variants-label]'),
      pills: document.querySelector('[data-quick-add-pills]'),
      buyboxWrap: document.querySelector('[data-quick-add-buybox]'),
      buyboxLabel: document.querySelector('[data-quick-add-buybox-label]'),
      buyboxControls: document.querySelector('[data-quick-add-buybox-controls]'),
      sizeChart: document.querySelector('[data-quick-add-sizechart]'),
      sizeChartHead: document.querySelector('[data-quick-add-sizechart-head]'),
      sizeChartBody: document.querySelector('[data-quick-add-sizechart-body]'),
      qtyValue: document.querySelector('[data-quick-add-qty-value]'),
    };
  }

  function getFocusable(container) {
    if (!container) return [];
    return Array.from(
      container.querySelectorAll(
        'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
      )
    );
  }

  function renderQty() {
    const { qtyValue } = els();
    if (qtyValue) qtyValue.textContent = String(state.qty);
  }

  function setQty(n) {
    state.qty = Math.max(1, n);
    renderQty();
  }

  // Re-renders pressed state for ONE control's pills only (identified by
  // `data-control`, e.g. 'variant' for the product size row, 'c0'/'c1'… for
  // a course buybox pills row) — a pill is pressed iff its own value
  // matches that control's current selection. Scoped to the control so
  // selecting a pill in one course buybox row never touches another row's
  // pressed state.
  function renderPillPressedState(control) {
    document.querySelectorAll(`[data-quick-add-pill][data-control="${control}"]`).forEach((p) => {
      p.setAttribute('aria-pressed', String(p.getAttribute('data-quick-add-pill') === state.selections[control]));
    });
  }

  function selectPill(control, value) {
    state.selections[control] = value;
    renderPillPressedState(control);
  }

  // Normalizes a course's `item.pdp.buybox.controls` the SAME way
  // CourseDetails.astro's own `buyboxControls` does (byte-identical guard
  // logic, deliberately kept in sync rather than re-derived): default
  // `type: 'pills'`, per-control `show` computed from its own non-emptiness
  // (`select` survives on `placeholder` alone even with zero options — a
  // documented client stub, see catalog.js's FGA buybox comments — `pills`
  // needs at least one option), then filtered down to only the controls
  // that survive. `disabled` flags a zero-option select as `aria-disabled`
  // (not `disabled`) so it stays focusable/un-greyed like CourseDetails'
  // own select, instead of promising an operable combobox with nothing
  // behind it.
  function normalizeBuyboxControls(buybox) {
    return (buybox?.controls ?? [])
      .map((control) => {
        const type = control.type === 'select' ? 'select' : 'pills';
        const optionCount = control.options?.length ?? 0;
        const show = type === 'select' ? Boolean(control.placeholder) || optionCount > 0 : optionCount > 0;
        const disabled = type === 'select' && optionCount === 0;
        return { ...control, type, show, disabled };
      })
      .filter((control) => control.show);
  }

  // Builds one control's markup and (for `pills`) seeds `state.selections`.
  // `key` is `c${index}` — index into the FILTERED buyboxControls array
  // (mirrors CourseDetails.astro's own render-order indexing), shared by
  // both control types even though only `pills` uses it for selection
  // state — a `select` control reads its own DOM value at submit instead
  // (see this file's `state` header comment).
  function renderBuyboxControl(control, key, blockLabel) {
    if (control.type === 'select') {
      const ariaLabel = escapeHtml(control.ariaLabel ?? blockLabel ?? '');
      const placeholderOption = control.placeholder
        ? `<option value="" selected disabled hidden>${escapeHtml(control.placeholder)}</option>`
        : '';
      const options = (control.options ?? [])
        .map((opt) => `<option value="${escapeHtml(opt.href ?? opt.label)}">${escapeHtml(opt.label)}</option>`)
        .join('');
      const disabledAttr = control.disabled ? ' aria-disabled="true"' : '';
      return `<select class="quick-add-modal__select" data-quick-add-select aria-label="${ariaLabel}"${disabledAttr}>${placeholderOption}${options}</select>`;
    }

    // Pills — an `href` option is a CROSS-SELL NAVIGATION LINK to another
    // course's page (e.g. Sole Switch's single pill points at Sole Switch
    // Pro, and vice versa), not a selectable variant — mirrors
    // CourseDetails.astro's own `option.href ? <a> : <span>` split (lines
    // ~189-208 there), except the non-href branch here is a real toggle
    // BUTTON (not a static `<span>`) since this modal's pills ARE
    // selectable, unlike the PDP's read-only tier display. An `href` pill
    // therefore renders as a real `<a>`, is NEVER pre-selected into
    // `state.selections`, and carries none of `data-quick-add-pill` /
    // `data-control` / `aria-pressed` — so the delegated click handler's
    // `[data-quick-add-pill]` branch never matches it and lets the browser
    // navigate natively.
    //
    // Selection seeding pre-selects the `selected: true` option among the
    // NON-href options only (fallback: the first non-href option) so Add to
    // Cart always has a valid selection when there IS a real variant to
    // pick, same guarantee the product size pills already give. A control
    // made up ENTIRELY of href options (Sole Switch/Sole Switch Pro's own
    // single cross-sell pill) contributes NO key to `state.selections` at
    // all — there's no variant to select; the course itself is what's being
    // added to cart.
    const options = control.options ?? [];
    const nonHrefOptions = options.filter((opt) => !opt.href);
    const selected = nonHrefOptions.find((opt) => opt.selected) ?? nonHrefOptions[0];
    if (selected) state.selections[key] = selected.label;
    const pills = options
      .map((opt) => {
        if (opt.href) {
          const selectedClass = opt.selected ? ' quick-add-modal__pill--selected' : '';
          const ariaCurrent = opt.selected ? ' aria-current="true"' : '';
          return `<a class="quick-add-modal__pill quick-add-modal__pill--link${selectedClass}" href="${escapeHtml(opt.href)}"${ariaCurrent}>${escapeHtml(opt.label)}</a>`;
        }
        return `<button type="button" class="quick-add-modal__pill" data-control="${key}" data-quick-add-pill="${escapeHtml(opt.label)}" aria-pressed="${opt.label === state.selections[key]}">${escapeHtml(opt.label)}</button>`;
      })
      .join('');
    return `<div class="quick-add-modal__pills">${pills}</div>`;
  }

  // Fills the SSR-stable modal markup from a catalog item. Products and
  // courses are mutually exclusive BY DATA (an item has `item.variants` XOR
  // `item.pdp.buybox`, never both — see this file's header comment), so
  // exactly one of the two branches below ever unhides its container; an
  // item with neither (e.g. Foot Fest) leaves both hidden and the Options
  // block just holds the qty row. Each branch pre-selects a valid option
  // (first variant / each pills control's `selected:true` or first NON-href
  // option — see renderBuyboxControl) so Add to Cart always yields a valid
  // line without requiring the shopper to make a choice first, except a
  // pills control made up entirely of cross-sell `href` options (no real
  // variant to select) which contributes no selection at all.
  function populate(item) {
    const e = els();
    if (!e.modal) return;

    state.item = item;
    state.selections = {};
    state.qty = 1;

    if (e.title) e.title.textContent = item.title;
    if (e.price) e.price.textContent = item.priceRange || item.price || '';
    if (e.image) {
      e.image.src = item.image;
      e.image.alt = item.title;
    }

    // Task 3 — reset on EVERY populate() call so a previous item's note
    // never leaks into the next: only show + fill it when the new item
    // actually carries `item.quickAddNote` (today, only foot-health-kit).
    if (e.note) {
      if (item.quickAddNote) {
        e.note.textContent = item.quickAddNote;
        e.note.hidden = false;
      } else {
        e.note.textContent = '';
        e.note.hidden = true;
      }
    }

    if (item.variants && e.variantsWrap && e.pills) {
      e.variantsWrap.hidden = false;
      if (e.variantsLabel) e.variantsLabel.textContent = item.variants.label;
      state.selections.variant = item.variants.options[0];
      e.pills.innerHTML = item.variants.options
        .map(
          (opt) =>
            `<button type="button" class="quick-add-modal__pill" data-control="variant" data-quick-add-pill="${escapeHtml(opt)}" aria-pressed="${opt === state.selections.variant}">${escapeHtml(opt)}</button>`
        )
        .join('');
    } else {
      if (e.variantsWrap) e.variantsWrap.hidden = true;
      if (e.pills) e.pills.innerHTML = '';
    }

    // Course path — renders item.pdp.buybox the same way CourseDetails.astro
    // does (see normalizeBuyboxControls/renderBuyboxControl above): one
    // shared `buybox.label` caption, then each surviving control (pills row
    // and/or Location select) in order. `!item.variants` keeps this and the
    // product branch above mutually exclusive even if a future item's data
    // were ever malformed enough to carry both.
    const buybox = !item.variants ? item.pdp?.buybox : null;
    const buyboxControls = normalizeBuyboxControls(buybox);
    if (buyboxControls.length > 0 && e.buyboxWrap && e.buyboxControls) {
      e.buyboxWrap.hidden = false;
      if (e.buyboxLabel) e.buyboxLabel.textContent = buybox.label ?? '';
      e.buyboxControls.innerHTML = buyboxControls
        .map((control, index) => renderBuyboxControl(control, `c${index}`, buybox.label))
        .join('');
    } else {
      if (e.buyboxWrap) e.buyboxWrap.hidden = true;
      if (e.buyboxControls) e.buyboxControls.innerHTML = '';
    }

    if (item.sizeChart && e.sizeChart && e.sizeChartHead && e.sizeChartBody) {
      e.sizeChart.hidden = false;
      e.sizeChartHead.innerHTML = `<tr>${item.sizeChart.columns.map((c) => `<th scope="col">${escapeHtml(c)}</th>`).join('')}</tr>`;
      e.sizeChartBody.innerHTML = item.sizeChart.rows
        .map((row) => `<tr>${row.map((cell) => `<td>${escapeHtml(cell)}</td>`).join('')}</tr>`)
        .join('');
    } else if (e.sizeChart) {
      e.sizeChart.hidden = true;
    }

    renderQty();
  }

  function openModal(item, trigger) {
    const e = els();
    if (!e.modal || !e.scrim) return;

    populate(item);
    state.trigger = trigger ?? null;

    e.modal.hidden = false;
    e.modal.removeAttribute('inert');
    e.modal.setAttribute('aria-hidden', 'false');
    e.scrim.hidden = false;

    // Two-step unhide -> add-class so the opacity/scale transition actually
    // runs (toggling a class in the same frame `hidden` is removed wouldn't
    // give the browser a "from" state to transition out of).
    requestAnimationFrame(() => e.modal.classList.add('is-open'));

    const focusable = getFocusable(e.modal);
    (focusable[0] || e.modal).focus();
  }

  function closeModal() {
    const e = els();
    if (!e.modal || !e.scrim) return;
    const trigger = state.trigger;

    e.modal.classList.remove('is-open');
    e.modal.hidden = true;
    e.modal.setAttribute('inert', '');
    e.modal.setAttribute('aria-hidden', 'true');
    e.scrim.hidden = true;

    state.trigger = null;
    trigger?.focus();
  }

  // Task 3 (cart-line selection summary): builds one readable string out of
  // every current selection so the cart drawer shows what was actually
  // chosen, not just the item name. `state.selections` already stores
  // LABELS (not raw values) — a product's size ('Small') or a course pill's
  // option label — keyed in control order (see this file's `state` header
  // comment), so `Object.values(...)` alone yields the parts in the right
  // order. The Location `<select>` is deliberately NOT in `state.selections`
  // (see that same header comment) so it's read straight off the DOM here;
  // its TEXT is used rather than `.value` because renderBuyboxControl's
  // `<option value="${opt.href ?? opt.label}">` can put an HREF in `.value`
  // (mirroring CourseDetails.astro's own PDP select) — using `.value`
  // directly would leak a URL into the cart line instead of a label like
  // "In-Person". The placeholder option has `value=""`, which is falsy, so
  // an unchosen select is correctly omitted rather than stringified. Yields
  // e.g. "Small" for a sized product, "In-Person" for a course with a real
  // Location choice, or `null` for an item with no selectable variant at all
  // (e.g. Sole Switch's href-only cross-sell pill contributes no key to
  // `state.selections`).
  function selectionSummary() {
    const pillParts = Object.values(state.selections).filter(Boolean);
    const sel = document.querySelector('[data-quick-add-select]');
    const selText = sel && sel.value ? (sel.options[sel.selectedIndex]?.text ?? null) : null;
    return [...pillParts, selText].filter(Boolean).join(' / ') || null;
  }

  function submitAddToCart() {
    const item = state.item;
    if (!item) return;

    addLine({
      id: item.id,
      title: item.title,
      variant: selectionSummary(),
      price: item.price ?? item.priceRange,
      qty: state.qty,
      image: item.image,
      href: item.href,
    });

    closeModal();
    // Open the cart drawer via its existing header trigger rather than
    // duplicating CartDrawer's open logic — Header.astro's click handler
    // already opens it, and addLine()'s `cart:change` event has already
    // refreshed the drawer contents + badge (see cart.js / CartDrawer.astro).
    document.querySelector('[data-util="cart"]')?.click();
  }

  // Resets in-memory state (and defensively re-closes the modal) on initial
  // load and after every View Transition swap. Each swap brings a brand-new,
  // already-closed modal element from the server, so this mainly guards
  // against a stray `state.trigger` reference to a DOM node the swap just
  // removed (e.g. a navigation firing while the modal happened to be open).
  function resetQuickAdd() {
    state.item = null;
    state.selections = {};
    state.qty = 1;
    state.trigger = null;
    const e = els();
    if (e.modal) {
      e.modal.classList.remove('is-open');
      e.modal.hidden = true;
      e.modal.setAttribute('inert', '');
      e.modal.setAttribute('aria-hidden', 'true');
    }
    if (e.scrim) e.scrim.hidden = true;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', resetQuickAdd);
  } else {
    resetQuickAdd();
  }
  document.addEventListener('astro:after-swap', resetQuickAdd);

  // Single delegated click listener, bound once at module scope, handles
  // the entire interactive surface: opening from any `[data-quick-add]`
  // trigger (there are many, re-rendered per PLP page — see PlpCard.astro),
  // and everything inside the modal itself (close, scrim, variant pills,
  // qty stepper, submit). Pills/size-chart rows are (re)written via
  // innerHTML in populate() above, so delegation is required for them —
  // a per-element listener would be lost on the next populate() call.
  document.addEventListener('click', (e) => {
    const target = e.target;
    if (!(target instanceof Element)) return;

    const trigger = target.closest('[data-quick-add]');
    if (trigger) {
      const id = trigger.getAttribute('data-quick-add');
      const item = id ? getItem(id) : undefined;
      if (item) openModal(item, trigger);
      return;
    }

    if (target.closest('[data-quick-add-close]')) {
      closeModal();
      return;
    }
    if (target.closest('[data-quick-add-scrim]')) {
      closeModal();
      return;
    }

    const pill = target.closest('[data-quick-add-pill]');
    if (pill) {
      const control = pill.getAttribute('data-control');
      if (control) selectPill(control, pill.getAttribute('data-quick-add-pill'));
      return;
    }
    if (target.closest('[data-quick-add-qty-incr]')) {
      setQty(state.qty + 1);
      return;
    }
    if (target.closest('[data-quick-add-qty-decr]')) {
      setQty(state.qty - 1);
      return;
    }
    if (target.closest('[data-quick-add-submit]')) {
      submitAddToCart();
      return;
    }
  });

  // Esc-to-close + a simple Tab/Shift+Tab focus trap while the modal is
  // open — also bound once at module scope. Reads the modal's current
  // open state fresh via `hidden` each keystroke rather than a cached flag.
  document.addEventListener('keydown', (e) => {
    const { modal } = els();
    if (!modal || modal.hidden) return;

    if (e.key === 'Escape') {
      e.preventDefault();
      closeModal();
      return;
    }

    if (e.key !== 'Tab') return;
    const focusable = getFocusable(modal);
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });
</script>
<style>
  .quick-add-scrim {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    z-index: 69;
  }
  .quick-add-scrim[hidden] { display: none; }

  .quick-add-modal {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.96);
    opacity: 0;
    width: min(800px, 94vw);
    max-height: 88vh;
    overflow-y: auto;
    background: var(--color-paper);
    color: var(--color-ink);
    z-index: 70;
    transition:
      opacity var(--motion-base) var(--ease-standard),
      transform var(--motion-base) var(--ease-standard);
  }
  .quick-add-modal.is-open {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
  .quick-add-modal[hidden] { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .quick-add-modal { transition: none; }
  }

  .quick-add-modal__close {
    position: absolute;
