---
// PLP composer: title -> filter/sort -> grid(+intro) -> pagination.
// Accepts either an already-resolved `collection` object or a `path` to
// resolve via getCollection (matches Task 1's catalog accessors).
// CrossSell + LogoWall sections render after Pagination (Task 3).
import PlpTitle from './PlpTitle.astro';
import FilterSortBar from './FilterSortBar.astro';
import PlpGrid from './PlpGrid.astro';
import Pagination from './Pagination.astro';
import CrossSell from './CrossSell.astro';
import LogoWall from './LogoWall.astro';
import { getCollection, getItem, pressLogos } from '../../data/catalog.js';

const { collection: collectionProp, path } = Astro.props;
const collection = collectionProp ?? getCollection(path);
const items = (collection.itemIds ?? []).map(getItem);
---
<div class="plp">
  <div class="plp__pad">
    <div data-reveal>
      <PlpTitle title={collection.title} />
    </div>
    <FilterSortBar count={items.length} />
  </div>
  <!-- Grid breaks out to full width (Polaroid-style full-bleed cards). -->
  <div class="plp__grid-wrapper" data-reveal>
    <PlpGrid items={items} intro={collection.intro} />
  </div>
  <div class="plp__pad">
    <Pagination />
  </div>
  <div data-reveal>
    <CrossSell crossSell={collection.crossSell} />
  </div>
  <div data-reveal>
    <LogoWall logos={pressLogos} />
  </div>
</div>
<style>
  /* Title, filter bar and pagination stay padded from the viewport edges;
     the card grid between them spans full width. */
  .plp__pad { padding-inline: var(--space-5); }
</style>
