---
// Full-width "As Seen In" press band. Placeholder text wordmarks (real
// logo marks are a later content swap) rendered from `pressLogos` by default.
import { pressLogos } from '../../data/catalog.js';

const { logos = pressLogos } = Astro.props;
---
<section class="logo-wall">
  <div class="logo-wall__pad">
    <h2 class="logo-wall__heading">As Seen In</h2>
    <ul class="logo-wall__row">
      {logos.map((name) => (
        <li class="logo-wall__item">{name}</li>
      ))}
    </ul>
  </div>
</section>
<style>
  .logo-wall {
    background: var(--color-paper);
  }

  .logo-wall__pad {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-block: var(--space-8);
    padding-inline: var(--space-5);
    text-align: center;
  }

  .logo-wall__heading {
    font: var(--type-h4);
    color: var(--color-teal);
    margin-bottom: var(--space-6);
  }

  .logo-wall__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
    list-style: none;
  }

  .logo-wall__item {
    font: var(--type-label);
    color: var(--color-ink-70);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caption);
    white-space: nowrap;
  }
</style>
